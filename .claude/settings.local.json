{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "PowerShell(git *)",
      "PowerShell(npm run *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm ls *)",
      "PowerShell(npx prisma *)",
      "PowerShell(npx tsc *)",
      "PowerShell(node *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Out-Null *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Add-Content *)",
      "PowerShell(netstat *)",
      "PowerShell(findstr *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx prisma *)",
      "Bash(Get-ChildItem *)",
      "Bash(Get-Content *)",
      "Bash(dir *)",
      "Bash(ls *)",
      "Bash(powershell *)",
      "WebSearch",
      "Skill(update-config)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-docs.ps1",
            "shell": "powershell",
            "timeout": 20,
            "statusMessage": "Verificando si CLAUDE.md esta al dia..."
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell"
}
