{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "PowerShell(git *)",
      "PowerShell(npm run *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm ls *)",
      "PowerShell(npx prisma *)",
      "PowerShell(npx tsc *)",
      "PowerShell(node *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Out-Null *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Add-Content *)",
      "PowerShell(netstat *)",
      "PowerShell(findstr *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx prisma *)",
      "Bash(Get-ChildItem *)",
      "Bash(Get-Content *)",
      "Bash(dir *)",
      "Bash(ls *)",
      "Bash(powershell *)",
      "WebSearch",
      "Skill(update-config)",
      "Bash(npm ls *)",
      "Bash(node -e \"const p=require\\('./package.json'\\); console.log\\(JSON.stringify\\(p.devDependencies,null,2\\)\\)\")",
      "PowerShell(ConvertTo-Json *)",
      "PowerShell(npx vitest run src/app/api/gastos/route.test.ts 2>&1 | Select-Object -Last 35)",
      "PowerShell(if \\(Test-Path node_modules/undici/package.json\\) { \\(Get-Content node_modules/undici/package.json -Raw | ConvertFrom-Json\\).version } else { \"undici NOT found\" })",
      "PowerShell(npx vitest run src/app/api/gastos/route.test.ts 2>&1 | Select-Object -Last 30)",
      "PowerShell(npx tsc --noEmit; if \\($?\\) { \"TYPECHECK OK\" })",
      "PowerShell(git config *)",
      "PowerShell(& \"C:\\\\Program Files\\\\Git\\\\bin\\\\sh.exe\" .githooks/pre-commit 2>&1 | Select-Object -Last 6)",
      "PowerShell($sh = \\(Get-Command sh -ErrorAction SilentlyContinue\\).Source; if \\(-not $sh\\) { $sh = \\(Get-Command bash -ErrorAction SilentlyContinue\\).Source }; \"Using: $sh\"; if \\($sh\\) { & $sh .githooks/pre-commit 2>&1 | Select-Object -Last 6 })",
      "Bash(sh .githooks/pre-commit)",
      "Bash(echo \"HOOK EXIT=$?\")",
      "Bash(echo \"EXIT=$?\")",
      "PowerShell(npx tsc --noEmit; if \\($?\\) { \"TYPECHECK OK\" } else { \"TYPECHECK FAILED\" })",
      "Bash(gh --version)",
      "PowerShell($gh = \\(Get-Command gh -ErrorAction SilentlyContinue\\); if \\($gh\\) { \"gh found: $\\($gh.Source\\)\" } else { \"gh NOT found\" })"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-docs.ps1",
            "shell": "powershell",
            "timeout": 20,
            "statusMessage": "Verificando si CLAUDE.md esta al dia..."
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell"
}
