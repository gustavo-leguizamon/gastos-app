generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Moneda {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique
  nombre   String
  simbolo  String
  gastos      Gasto[]
  ingresos    Ingreso[]
  inversiones Inversion[]
}

model Casa {
  id       Int       @id @default(autoincrement())
  nombre   String
  gastos   Gasto[]
  ingresos Ingreso[]
}

model Tarjeta {
  id        Int             @id @default(autoincrement())
  nombre    String
  banco     String?
  marca     String?
  bancoLogo String?
  /// Icono subido por el usuario (data URI, ver src/lib/imagen-icono.ts). Gana sobre bancoLogo.
  bancoIcono String?
  gastos    Gasto[]
  cierres   TarjetaCierre[]
}

model TarjetaCierre {
  id                  Int      @id @default(autoincrement())
  tarjetaId           Int
  mes                 Int
  anio                Int
  fechaCierre         String?
  fechaVencimiento    String?
  fechaProximoCierre  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tarjeta Tarjeta @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)

  @@unique([tarjetaId, mes, anio])
}

// Categoría: partición (una por gasto/item) — responde "¿en qué rubro se fue la plata?".
// Es la dimensión canónica del reporte por categoría (suma 100%, sin duplicar).
model Categoria {
  // Único, igual que `Concepto.nombre`: un duplicado por typo/casing parte el reporte por
  // categoría en dos sin que nada lo señale. El match case-insensitive lo hace
  // `resolveCategoria` en los write paths (el índice de Postgres es case-sensitive).
  id     Int         @id @default(autoincrement())
  nombre String      @unique
  gastos Gasto[]
  items  GastoItem[]
  presupuestos Presupuesto[]
  reglasEtiquetas CategoriaEtiquetaRegla[]
}

/// Tope de gasto mensual de una categoría. La app mostraba montos absolutos pero nada contra
/// qué compararlos: no había forma de responder "¿me pasé en Comida este mes?".
///
/// Es por (categoría, mes, año) y no un default que se arrastra, para que cambiar el
/// presupuesto de un mes no reescriba la historia de los meses ya cerrados. La **ausencia de
/// fila significa "sin presupuesto"**, que no es lo mismo que un presupuesto en 0 (ese sí
/// dice "acá no se gasta nada" y cualquier gasto lo excede).
model Presupuesto {
  id          Int      @id @default(autoincrement())
  categoriaId Int
  mes         Int
  anio        Int
  monto       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, mes, anio])
  @@index([anio, mes])
}

// Etiqueta: corte transversal (varias por gasto/item) — labels que se solapan a propósito
// (ej. "Viaje", "Deducible", "Compartido"). Migradas desde el viejo M2M de Categoria.
model Etiqueta {
  id     Int         @id @default(autoincrement())
  nombre String      @unique
  gastos Gasto[]     @relation("GastoEtiquetas")
  items  GastoItem[] @relation("GastoItemEtiquetas")
  reglas CategoriaEtiquetaRegla[]
}

/// Corrección manual de qué etiquetas ofrece el form para una categoría.
///
/// La lista base **no** se guarda: se deriva del histórico (`src/lib/etiquetas-sugeridas.ts`),
/// porque una whitelist completa mantenida a mano obligaría a declarar las etiquetas
/// transversales —`Mercado Libre`, `Mercado Pago`, `PedidosYa`— en casi todas las categorías, y
/// la que se olvide termina retipeada como variante del mismo nombre. Esta tabla es sólo la
/// capa de excepciones sobre eso: **la ausencia de fila es el caso normal**.
///
/// `modo`: `'fijar'` = ofrecerla en esta categoría aunque el histórico no la respalde (sirve
/// para la categoría nueva, que arranca sin datos); `'excluir'` = no ofrecerla nunca acá, ni
/// siquiera si es transversal o si ya se usó (un uso puntual mal clasificado no tiene por qué
/// contaminar la lista para siempre). Excluir gana sobre fijar y sobre el histórico.
///
/// `onDelete: Cascade` en las dos puntas: una regla sobre una categoría o etiqueta borrada no
/// significa nada, y no cuenta como "uso" que impida borrarlas.
model CategoriaEtiquetaRegla {
  id          Int      @id @default(autoincrement())
  categoriaId Int
  etiquetaId  Int
  modo        String
  createdAt   DateTime @default(now())

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  etiqueta  Etiqueta  @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, etiquetaId])
}

// Concepto: entidad canónica del "qué" de un gasto/sub-item (ej: Netflix, Luz, Expensas).
// Reemplaza al texto libre `descripcion` como fuente de verdad: gastos e items apuntan por
// `conceptoId` y la API expone `descripcion` derivada de `nombre`. Renombrar un concepto se
// refleja en todo el histórico. El match para analytics (evolución, estimado, copiar) usa el id.
model Concepto {
  id        Int         @id @default(autoincrement())
  nombre    String      @unique
  createdAt DateTime    @default(now())
  gastos    Gasto[]
  items     GastoItem[]
}

model Gasto {
  id                   Int      @id @default(autoincrement())
  casaId               Int
  conceptoId           Int
  fechaVencimiento     String
  tipoPago             String
  monedaId             Int
  tipoCambio           Float    @default(1)
  totalMoneda          Float
  totalPagado          Float    @default(0)
  pasajeMesSiguiente   Float    @default(0)
  prestamo_a_otro      Float    @default(0)
  tarjetaId            Int?
  cuotaActual          Int?
  cuotasTotales        Int?
  mes                  Int
  anio                 Int
  notas                String?
  confirmado           Boolean  @default(true)
  esTarjeta            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categoriaId          Int?

  casa    Casa     @relation(fields: [casaId], references: [id])
  moneda  Moneda   @relation(fields: [monedaId], references: [id])
  tarjeta   Tarjeta?   @relation(fields: [tarjetaId], references: [id])
  concepto  Concepto   @relation(fields: [conceptoId], references: [id])
  categoria  Categoria? @relation(fields: [categoriaId], references: [id])
  etiquetas Etiqueta[] @relation("GastoEtiquetas")
  pagos     Pago[]
  items     GastoItem[]

  // Casi toda query de la app filtra por período (y muy seguido también por casa):
  // la grilla de gastos, el resumen, la evolución, los reportes y el cron de
  // vencimientos. Sin este índice la tabla se recorría entera en cada una.
  @@index([anio, mes, casaId])
  // El match entre meses (evolución, estimado del próximo mes, copiar/merge) es por
  // conceptoId; `Concepto` puede tener muchos gastos y la FK no indexa sola en Postgres.
  @@index([conceptoId])
}

model GastoItem {
  id            Int      @id @default(autoincrement())
  gastoId       Int
  conceptoId    Int
  monto         Float
  fecha         String?
  cuotaActual          Int?
  cuotasTotales        Int?
  incluyeEnTotal       Boolean  @default(true)
  incluyeEnVencimiento Boolean  @default(false)
  verificado           Boolean  @default(false)
  pagoId               Int?
  categoriaId          Int?
  createdAt            DateTime @default(now())

  gasto     Gasto      @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  concepto  Concepto   @relation(fields: [conceptoId], references: [id])
  categoria  Categoria? @relation(fields: [categoriaId], references: [id])
  etiquetas Etiqueta[] @relation("GastoItemEtiquetas")
  pago      Pago?      @relation(fields: [pagoId], references: [id], onDelete: Cascade)
}

// Ingreso de dinero de un mes. Se cargan varios por mes (los cobros pueden entrar en días
// distintos) y el total del mes es la suma. Igual que en `Gasto`, `mes`/`anio` son explícitos
// y NO se derivan de `fecha`: permiten imputar un cobro que entró un día a otro mes.
// `casaId` es opcional — un ingreso sin casa es "general" y cuenta para cualquier casa.
// La moneda sigue el mismo mecanismo que `Gasto`: `montoMoneda * tipoCambio` = monto en ARS,
// con `tipoCambio` en 1 cuando la moneda es ARS (el caso normal).
model Ingreso {
  id          Int      @id @default(autoincrement())
  fecha       String
  mes         Int
  anio        Int
  monedaId    Int
  tipoCambio  Float    @default(1)
  montoMoneda Float
  descripcion String?
  casaId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  casa   Casa?  @relation(fields: [casaId], references: [id])
  moneda Moneda @relation(fields: [monedaId], references: [id])

  @@index([anio, mes])
}

model Inversion {
  id          Int          @id @default(autoincrement())
  nombre      String
  /// Moneda en la que están expresados los montos de sus movimientos. Null = ARS, que es
  /// el comportamiento histórico (antes de que la inversión tuviera moneda todo se cargaba
  /// como número pelado). No hay tipo de cambio: una inversión en USD se sigue en USD, no
  /// se convierte — mezclar cotizaciones inventaría un rendimiento que no ocurrió.
  monedaId    Int?
  createdAt   DateTime     @default(now())
  moneda      Moneda?      @relation(fields: [monedaId], references: [id])
  movimientos Movimiento[]
}

model Movimiento {
  id          Int      @id @default(autoincrement())
  inversionId Int
  fecha       String
  montoActual Float
  movimiento  Float    @default(0)
  createdAt   DateTime @default(now())

  inversion Inversion @relation(fields: [inversionId], references: [id], onDelete: Cascade)
}

model Settings {
  id                          Int      @id @default(1)
  estimMesesAtras             Int      @default(2)
  estimMissingBehavior        String   @default("zero")
  estimIncluirCuotasVigentes  Boolean  @default(true)
  estimExcluirUltimaCuota     Boolean  @default(true)
  // Casa preseleccionada al abrir el alta de un gasto. Null = sin default (el usuario elige),
  // salvo que exista una sola casa (en ese caso GastoForm la autocompleta igual).
  casaDefaultId               Int?
  updatedAt                   DateTime @updatedAt
}

model Sueldo {
  id             Int      @id @default(autoincrement())
  fecha          String
  /// Período al que se imputa el cobro. Explícitos, misma convención que `Gasto` e `Ingreso`:
  /// permiten imputar a agosto un sueldo cobrado el 31 de julio, y hacen que cruzar ingresos
  /// con gastos por período no dependa de derivar el mes de una fecha.
  mes            Int
  anio           Int
  sueldoTeorico  Float    @default(0)
  sueldoArs      Float    @default(0)
  sueldoUsd      Float    @default(0)
  cotizacionBna  Float    @default(0)
  cotizacionMep  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([anio, mes])
}

model Pago {
  id        Int      @id @default(autoincrement())
  gastoId   Int
  fecha     String
  monto     Float
  createdAt DateTime @default(now())

  gasto Gasto       @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  items GastoItem[]
}

/// Suscripción Web Push de un browser/dispositivo. Un mismo email puede tener varias
/// (celular, desktop, PWA instalada). `endpoint` es la URL del push service y es la
/// identidad de la suscripción — si el browser la renueva, cambia el endpoint.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
}
