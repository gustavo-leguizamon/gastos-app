generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Moneda {
  id      Int     @id @default(autoincrement())
  codigo  String  @unique
  nombre  String
  simbolo String
  gastos  Gasto[]
}

model Casa {
  id     Int     @id @default(autoincrement())
  nombre String
  gastos Gasto[]
}

model Tarjeta {
  id     Int     @id @default(autoincrement())
  nombre String
  banco  String?
  gastos Gasto[]
}

model Categoria {
  id     Int         @id @default(autoincrement())
  nombre String
  gastos Gasto[]
  items  GastoItem[]
}

model Gasto {
  id                   Int      @id @default(autoincrement())
  casaId               Int
  descripcion          String
  fechaVencimiento     String
  tipoPago             String
  monedaId             Int
  tipoCambio           Float    @default(1)
  totalMoneda          Float
  totalPagado          Float    @default(0)
  pasajeMesSiguiente   Float    @default(0)
  prestamo_a_otro      Float    @default(0)
  tarjetaId            Int?
  categoriaId          Int?
  cuotaActual          Int?
  cuotasTotales        Int?
  mes                  Int
  anio                 Int
  notas                String?
  confirmado           Boolean  @default(true)
  esTarjeta            Boolean  @default(false)
  fechaCierre          String?
  fechaProximoCierre   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  casa    Casa     @relation(fields: [casaId], references: [id])
  moneda  Moneda   @relation(fields: [monedaId], references: [id])
  tarjeta   Tarjeta?   @relation(fields: [tarjetaId], references: [id])
  categoria Categoria? @relation(fields: [categoriaId], references: [id])
  pagos     Pago[]
  items     GastoItem[]
}

model GastoItem {
  id            Int      @id @default(autoincrement())
  gastoId       Int
  descripcion   String
  monto         Float
  fecha         String?
  cuotaActual          Int?
  cuotasTotales        Int?
  incluyeEnTotal       Boolean  @default(true)
  incluyeEnVencimiento Boolean  @default(false)
  categoriaId          Int?
  createdAt            DateTime @default(now())

  gasto     Gasto      @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id])
}

model Inversion {
  id          Int          @id @default(autoincrement())
  nombre      String
  createdAt   DateTime     @default(now())
  movimientos Movimiento[]
}

model Movimiento {
  id          Int      @id @default(autoincrement())
  inversionId Int
  fecha       String
  montoActual Float
  montoExtra  Float    @default(0)
  createdAt   DateTime @default(now())

  inversion Inversion @relation(fields: [inversionId], references: [id], onDelete: Cascade)
}

model Settings {
  id                          Int      @id @default(1)
  estimMesesAtras             Int      @default(2)
  estimMissingBehavior        String   @default("zero")
  estimIncluirCuotasVigentes  Boolean  @default(true)
  estimExcluirUltimaCuota     Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
}

model Pago {
  id        Int      @id @default(autoincrement())
  gastoId   Int
  fecha     String
  monto     Float
  createdAt DateTime @default(now())

  gasto Gasto @relation(fields: [gastoId], references: [id], onDelete: Cascade)
}
